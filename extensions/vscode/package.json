{
  "name": "print-widget-preview",
  "displayName": "Print Widget Preview",
  "description": "Preview and compare Flutter widget screenshots generated by print_widget",
  "version": "0.1.0",
  "publisher": "print-widget",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "flutter",
    "widget",
    "screenshot",
    "preview",
    "figma",
    "comparison"
  ],
  "activationEvents": [
    "workspaceContains:**/manifest.json"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icons/print-widget.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "printWidgetExplorer",
          "title": "Print Widget",
          "icon": "media/icons/sidebar.svg"
        }
      ]
    },
    "views": {
      "printWidgetExplorer": [
        {
          "id": "printWidget.screenshots",
          "name": "Screenshots",
          "icon": "media/icons/sidebar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "printWidget.refresh",
        "title": "Refresh Screenshots",
        "category": "Print Widget",
        "icon": "$(refresh)"
      },
      {
        "command": "printWidget.previewImage",
        "title": "Preview Screenshot",
        "category": "Print Widget",
        "icon": "$(eye)"
      },
      {
        "command": "printWidget.compareDevices",
        "title": "Compare Devices",
        "category": "Print Widget",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "printWidget.diffWithPrevious",
        "title": "Diff with Previous",
        "category": "Print Widget",
        "icon": "$(diff)"
      },
      {
        "command": "printWidget.compareWithFigma",
        "title": "Compare with Figma Design",
        "category": "Print Widget",
        "icon": "$(file-media)"
      },
      {
        "command": "printWidget.goToSource",
        "title": "Go to Definition",
        "category": "Print Widget",
        "icon": "$(go-to-file)"
      },
      {
        "command": "printWidget.selectManifest",
        "title": "Select Manifest File",
        "category": "Print Widget"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "printWidget.refresh",
          "when": "view == printWidget.screenshots",
          "group": "navigation"
        },
        {
          "command": "printWidget.selectManifest",
          "when": "view == printWidget.screenshots"
        }
      ],
      "view/item/context": [
        {
          "command": "printWidget.previewImage",
          "when": "viewItem == device || viewItem == stateDevice",
          "group": "inline"
        },
        {
          "command": "printWidget.compareDevices",
          "when": "viewItem == feature || viewItem == state",
          "group": "inline"
        },
        {
          "command": "printWidget.compareWithFigma",
          "when": "viewItem == device || viewItem == stateDevice",
          "group": "1_compare"
        },
        {
          "command": "printWidget.diffWithPrevious",
          "when": "viewItem == device || viewItem == stateDevice",
          "group": "1_compare"
        },
        {
          "command": "printWidget.goToSource",
          "when": "viewItem == feature",
          "group": "2_navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "lint": "tsc --noEmit",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
}
